# Streamlit Secrets Configuration Template
# Copy this file to secrets.toml and fill in your values
# DO NOT commit secrets.toml to version control!

# Groq API Key (FREE!)
# Get your API key from: https://console.groq.com
# 1. Sign up for free (no credit card needed)
# 2. Go to API Keys section
# 3. Create a new API key
# 4. Copy and paste it below
GROQ_API_KEY = "gsk_your_api_key_here"

# Admin Password
# Change this to a secure password for admin access
ADMIN_PASSWORD = "admin123"
