# Docker ignore file - exclude unnecessary files from Docker image

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Data files (will be created in container)
data/*.db
data/*.sqlite3
data/uploads/*
data/chroma_db/*
!data/uploads/.gitkeep
!data/chroma_db/.gitkeep

# Secrets (NEVER include in image)
.streamlit/secrets.toml
.env

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test files
test_*.py
*_test.py

# Documentation
*.md
!README.md

# Logs
*.log

# Backup files
*.bak
*.backup
